# --- Database ---
# Connection string for your PostgreSQL database (Drizzle ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# --- OpenAI Integration ---
# Your OpenAI API Key for agent features (Required)
AI_INTEGRATIONS_OPENAI_API_KEY="sk-..."

# Base URL for the OpenAI API
AI_INTEGRATIONS_OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Authentication (Google OAuth) ---
# Create an OAuth Application in Google Cloud Console
# Authorized redirect URI: http://localhost:3000/api/callback
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Server Configurations ---
# The public URL where the frontend is accessible
PUBLIC_URL="http://localhost:3000"

# Port for the backend API (Defaults to 5000)
PORT="5000"

# Port for the frontend React app (Defaults to 3000)
VITE_PORT="3000"

# Base path for Vite serving (Defaults to /)
BASE_PATH="/"

# --- Slack ---
# SLACK_WEBHOOK_URL (Simplest setup: Incoming Webhook URL)
SLACK_WEBHOOK_URL=""
# SLACK_BOT_TOKEN / SLACK_NOTIFY_CHANNEL (Alternative: Web API with bot token)
SLACK_BOT_TOKEN=""
SLACK_NOTIFY_CHANNEL="#outbound-alerts"

# --- Cal.com ---
CALCOM_API_KEY=""
CALCOM_WEBHOOK_SECRET=""
